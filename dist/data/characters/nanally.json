    "passives": [
      {
        "nameKo": "열정 한 그릇 「추가」요",
        "unlock": "2단계",
        "effectKo": "「블라썸」강화:「창조의 줄기」가 발사하는 「창조의 꽃」수량이 10송이로 증가하며, 발사 간격이 1초로 단축된다."
      },
      {
        "nameKo": "절대 「공정」한 결투",
        "unlock": "4단계",
        "effectKo": "「초대 가주의 권능」상태에 있는 동안, 파티원이 적에게 에스퍼 사이클 피해를 1회 줄 때마다 나나리가 단일 적에게 추가 공격을 1회 추가로 시전하여 공격력의 60%만큼 령속성 이능력 피해를 준다. 피해 배율은 일반 공격 스킬 레벨에 따라 증가하며, Lv.11 에서 129.5%까지 증가한다. (2초당 최대 1회 발동)"
      }
    ],
    "citySkills": [
      {
        "nameKo": "가업",
        "categoryKo": "상점",
        "effectKo": "1단계에서 주요리 태그마다 가격이 0.2퐁스 오르고, 2·4단계에서 재료 소모가 각각 1% 줄어든다. 점주의 선택에서 방망이에 맞은 손님에게 현재 요리 가격의 115%를 받으며, 5단계에서는 주요리 태그 2개마다 가격이 0.3퐁스 더 오른다."
      }
    ],
    "sourceUrl": "https://neverness.app/characters/nanally"
