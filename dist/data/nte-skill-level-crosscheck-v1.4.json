    "japaneseCommunityWiki": {
      "name": "Neverness to Everness Wiki* (Japanese community wiki)",
      "url": "https://wikiwiki.jp/nte/",
      "levelHeaders": "Character pages with coefficient tables use LV1-LV12 columns. Blank cells remain unknown and are not interpolated.",
      "authority": "Unofficial community wiki; not an official client export. Page-level patch provenance is not consistently stated."
    },
    "prydwen": {
      "name": "Prydwen NTE character guides",
      "url": "https://www.prydwen.gg/neverness-to-everness/characters",
      "levelHeaders": "Character guides can explicitly label coefficient blocks 'Multipliers (Level 1)'; they are useful for Lv.1 spot checks, not full level curves.",
      "authority": "Unofficial guide. Page review/calculation patch differs by character."
    },
    "ntegameBlackbird": {
      "name": "ntegame Blackbird guide",
      "url": "https://ntegame.net/de/characters/blackbird/",
      "levelHeaders": "The 1.4 guide explicitly labels the off-field mark-triggered Lost Bird attack as Level 1: 200% ATK.",
      "authority": "Unofficial community guide based on the 1.4 release window; this is one isolated level-labelled effect, not a full skill table."
    },
    "nteStation": {
      "name": "异环信息站 (NTE Station; Chinese community database)",
      "url": "https://www.ntestation.com/",
      "levelHeaders": "Character pages expose interactive skill coefficient tables with level sliders. Values below were captured with each R3-affected skill slider set to Lv.11.",
      "authority": "Unofficial Chinese community database. Slider values and R3 descriptions were read from the rendered character pages; they are not an official Global client export."
    },
    "gameVika": {
      "name": "GameVika NTE Damage Calculator",
      "url": "https://gamevika.com/en/nte/damage",
      "levelHeaders": "Interactive character/skill/rank calculator. The page says it uses 744 skill-damage rows from the game's own data files and rank arrays of up to 15 values. A Shinku Basic Attack 1-1 check at rank 11 and ATK 1000 displayed non-crit damage 393, implying a 39.3% coefficient.",
      "authority": "Fan-made English-language calculator. It claims coefficients come from game data, but does not publish the source build/version tag; its character selector did not include the 1.3 Zankou/Linko or 1.4 Blackbird/Akane Rin additions during this check. Treat the captured Shinku result as a corroborating legacy-character spot check, not a complete 1.4 source."
    },
    "ntegameLocalized": {
      "name": "ntegame localized character guides (Korean/German/Spanish and other locales)",
      "url": "https://ntegame.net/ko/characters/blackbird/",
      "levelHeaders": "Blackbird's off-field mark-triggered Lost Bird attack is explicitly labelled Level 1: 200% ATK; the Korean, German, and Spanish pages carry matching text and the same 2026-09-28 China-server comparison note.",
      "authority": "Unofficial fan-guide site. Localized editions belong to one editorial source family and are not independent numerical confirmations."
    },
    "koreanInven": {
      "name": "이환 인벤 community and news pages",
      "url": "https://nte.inven.co.kr/?vtype=pc",
      "levelHeaders": "1.4 news, guides, and player discussions were found; no independent Korean full level-by-level character coefficient table was verified in this search.",
      "authority": "Korean community/news source. User-posted isolated numbers are leads only, not validated database values."
    }
  },
